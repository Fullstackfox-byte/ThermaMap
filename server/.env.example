# Server Port and Client Origin
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Database Connection (Optional - defaults to embedded DataStore if MongoDB is offline)
MONGODB_URI=mongodb://127.0.0.1:27017/smart_uhi_db

# Security & Authentication
JWT_SECRET=your_jwt_secret_key_min_32_chars
JWT_EXPIRES_IN=24h
ADMIN_SECRET=uhi-admin-secret-2026

# AI & Weather APIs
GEMINI_API_KEY=your_gemini_api_key_here
NASA_EARTHDATA_KEY=your_nasa_earthdata_key_here
OPENAQ_API_KEY=your_openaq_api_key_here

# Telemetry Generator Mode (set to 'false' to disable background pulse)
SIMULATE_TELEMETRY=true
